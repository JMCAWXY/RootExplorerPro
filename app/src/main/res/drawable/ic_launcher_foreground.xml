<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: two folder panes (the dual-pane file manager) with a shield
  badge for the root-privileged capability. Drawn on a 108x108 adaptive-icon viewport;
  content stays well inside the 72dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left pane: folder with tab -->
    <path
        android:fillColor="#FF3C4450"
        android:pathData="M23,34 h11 l4,5 h12 a3,3 0 0 1 3,3 v18 a3,3 0 0 1 -3,3 h-27 a3,3 0 0 1 -3,-3 v-23 a3,3 0 0 1 3,-3 z" />
    <!-- Left pane: lighter inner sheet to read as a document list -->
    <path
        android:fillColor="#FF9AA6B8"
        android:pathData="M26,45 h24 v2.5 h-24 z M26,51 h24 v2.5 h-24 z M26,57 h16 v2.5 h-16 z" />

    <!-- Right pane: folder with tab -->
    <path
        android:fillColor="#FF3C4450"
        android:pathData="M59,34 h11 l4,5 h12 a3,3 0 0 1 3,3 v18 a3,3 0 0 1 -3,3 h-27 a3,3 0 0 1 -3,-3 v-23 a3,3 0 0 1 3,-3 z" />
    <!-- Right pane: lighter inner sheet -->
    <path
        android:fillColor="#FF9AA6B8"
        android:pathData="M62,45 h24 v2.5 h-24 z M62,51 h24 v2.5 h-24 z M62,57 h16 v2.5 h-16 z" />

    <!-- Root shield badge, centered over the two panes -->
    <path
        android:fillColor="#FF2E7DF6"
        android:pathData="M54,12 l14,5 v12 q0,10 -14,15 q-14,-5 -14,-15 v-12 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M47.4,29.4 l-4.2,4.2 l6.4,6.4 l12.2,-12.2 l-4.2,-4.2 l-8,8 z" />

</vector>
